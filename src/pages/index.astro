---
import Layout from "@/layouts/Layout.astro";

const interests = [
    {
        area: "Language models",
        detail: "Agentic architectures, retrieval-augmented generation, supervised fine-tuning",
    },
    {
        area: "Efficient inference",
        detail: "Low-bit quantization (NVFP4 / W4A4), on-device and CPU-only deployment",
    },
    {
        area: "Representation learning",
        detail: "Topic modeling, semantic retrieval, recommender systems",
    },
    {
        area: "Scientific computing",
        detail: "Open-source machine learning tooling for the Julia ecosystem",
    },
];

const stack = [
    {
        label: "ML & LLMs",
        items: "PyTorch, HF Transformers, vLLM, llm-compressor, LLaMA-Factory, LangGraph, LlamaIndex, MCP/FastMCP",
    },
    {
        label: "Data & infra",
        items: "Spark, Airflow, Databricks, AWS, GCP, PostgreSQL/pgvector, Docker, Kubernetes",
    },
    {
        label: "Languages",
        items: "Python, SQL, Julia, TypeScript, C++, CUDA",
    },
];
---

<Layout canonical="/">
    <main class="max-w-6xl mx-auto px-6 sm:px-12 py-16">
        <div class="flex flex-col md:flex-row md:gap-12 lg:gap-20">
            <div class="md:w-1/3 md:shrink-0">
                <div class="md:sticky md:top-12">
                    <img
                        src="/profile.jpeg"
                        alt="Jose Esparza"
                        class="w-full max-w-xs md:max-w-none mx-auto md:mx-0 rounded-sm"
                    />
                    <p class="text-xs text-[var(--color-text-faint)] mt-4 italic">
                        Jose Esparza
                    </p>
                </div>
            </div>

            <div
                class="md:w-2/3 md:pl-10 md:border-l md:border-[var(--color-border-light)] space-y-10 mt-12 md:mt-0"
            >
                <div class="space-y-5 text-[var(--color-text)] leading-relaxed">
                    <p>
                        I engineer large language model systems and the
                        infrastructure that keeps them running in production:
                        agentic architectures, retrieval-augmented generation,
                        supervised fine-tuning and low-bit quantization. I am a
                        Senior Artificial Intelligence Engineer at Subatomic and
                        hold a concurrent contract at Maximo. I also founded{" "}
                        <a href="https://hoja-solutions.github.io" target="_blank">
                            Hoja
                        </a>, an AI and software consultancy.
                    </p>
                    <p>
                        For seven years before that I built machine learning and
                        data systems across education, fintech, retail, mining and
                        the public sector, first as an engineer and later leading
                        teams. You will find those years on my{" "}
                        <a href="/resume.pdf" target="_blank">resume</a>, and the
                        systems and publications on{" "}
                        <a href="/portfolio">the portfolio page</a>.
                    </p>
                    <p>
                        I am completing an MSc in Computer Science at the{" "}
                        <a href="https://www.london.ac.uk/" target="_blank">
                            University of London
                        </a>{" "}
                        (expected December 2026), and I graduated in Software
                        Engineering from{" "}
                        <a href="https://www.upn.edu.pe/" target="_blank">
                            Universidad Privada del Norte
                        </a>{" "}
                        with a 4.0 GPA. I started research at Binghamton
                        University in Arti Ramesh's lab, where Gisella Bejarano
                        mentored me; we published our work on public discourse
                        around COVID-19 vaccination at CSoNet 2021.
                    </p>
                    <p>
                        In Julia I maintain open-source scientific software:{" "}
                        <a
                            href="https://alan-turing-institute.github.io/MLJ.jl/dev/"
                            target="_blank"
                        >
                            MLJ.jl
                        </a>,{" "}
                        <a
                            href="https://github.com/JuliaAI/DearDiary.jl"
                            target="_blank"
                        >
                            DearDiary.jl
                        </a>{" "}
                        under the JuliaAI organization, and{" "}
                        <a
                            href="https://github.com/pebeto/MichiBoost.jl"
                            target="_blank"
                        >
                            MichiBoost.jl
                        </a>. Google Summer of Code funded my work bringing MLflow
                        to the ecosystem in 2023.
                    </p>
                    <p>
                        Outside work I sing in{" "}
                        <a
                            href="https://pebeto.github.io/elmejorveranodemivida/"
                            target="_blank"
                        >
                            El mejor verano de mi vida
                        </a>, play classical guitar and Magic: The Gathering, and
                        keep two cats.
                    </p>
                </div>

                <div>
                    <h2
                        class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-faint)] mb-4"
                    >
                        Research interests
                    </h2>
                    <dl class="space-y-3 text-sm">
                        {
                            interests.map((interest) => (
                                <div class="flex flex-col sm:flex-row sm:gap-4">
                                    <dt class="font-semibold text-[var(--color-heading)] sm:w-44 shrink-0">
                                        {interest.area}
                                    </dt>
                                    <dd class="text-[var(--color-text-muted)]">
                                        {interest.detail}
                                    </dd>
                                </div>
                            ))
                        }
                    </dl>
                </div>

                <div>
                    <h2
                        class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-faint)] mb-4"
                    >
                        Technical stack
                    </h2>
                    <dl class="space-y-3 text-sm">
                        {
                            stack.map((group) => (
                                <div class="flex flex-col sm:flex-row sm:gap-4">
                                    <dt class="font-semibold text-[var(--color-heading)] sm:w-44 shrink-0">
                                        {group.label}
                                    </dt>
                                    <dd class="text-[var(--color-text-muted)]">
                                        {group.items}
                                    </dd>
                                </div>
                            ))
                        }
                    </dl>
                    <p class="text-sm text-[var(--color-text-faint)] mt-4">
                        <a href="/resume.pdf" target="_blank"
                            >Full stack on my resume ↗</a
                        >
                    </p>
                </div>
            </div>
        </div>
    </main>
</Layout>
