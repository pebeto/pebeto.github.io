---
import Layout from "@/layouts/Layout.astro";
import { getNotebooks } from "@/lib/notebooks";
import type { FileResource } from "@/types/fileResource";

const notebooks = await getNotebooks();
const groupedNotebooks = notebooks.reduce(
    (acc, notebook) => {
        if (!acc[notebook.category]) {
            acc[notebook.category] = [];
        }
        acc[notebook.category].push(notebook);
        return acc;
    },
    {} as Record<string, FileResource[]>
);

const publications = [
    {
        title: "A Review of Topic Modeling: From Probabilistic Foundations to Neural and Multimodal Approaches",
        authors: "Esparza, J.",
        year: "2026",
        venue: "Preprint, Zenodo",
        href: "https://doi.org/10.5281/zenodo.20280741",
        doi: "10.5281/zenodo.20280741",
    },
    {
        title: "Understanding the Issues Surrounding COVID-19 Vaccine Roll Out via User Tweets",
        authors: "Esparza, J., Bejarano, G., Ramesh, A., & Seetharam, A.",
        year: "2021",
        venue: "Computational Data and Social Networks (CSoNet 2021), Lecture Notes in Computer Science, pp. 197–205. Springer",
        href: "https://doi.org/10.1007/978-3-030-91434-9_18",
        doi: "10.1007/978-3-030-91434-9_18",
    },
    {
        title: "Convolutional Neural Networks in Respiratory Conditions Detection: A Systematic Review of the Last 4 Years",
        authors: "Esparza, J.",
        year: "2020",
        venue: "Research poster, Summer School of Machine Learning (SMILES 2020), Skolkovo Institute of Science and Technology",
        href: "https://smiles.skoltech.ru/school-2020",
        doi: null,
    },
];

const systems = [
    {
        title: "Agentic AI-workforce platform",
        org: "Subatomic",
        desc: "I build a LangGraph agent system on FastAPI and Next.js: a ReAct supervisor over a self-critiquing four-sub-agent reasoning graph, plus ten specialized agents that integrate GitHub, Confluence, Monday.com, Slack and Google Drive. For retrieval I combined vector and full-text search with RRF/MMR reranking, chunk-level access control and provider failover. I also wrote the Redis job queue and WebSocket notifications behind the interaction-capture engine that feeds the CRM.",
    },
    {
        title: "Agentic banking assistant",
        org: "Maximo",
        desc: "For customer support on WhatsApp I built a LangGraph agent grounded in a Postgres/pgvector knowledge base, AWS-backed OTP delivery, audio transcription with faster-whisper, and monthly financial reports that an LLM drafts on a schedule. I added an MCP server that exposes internal tools to LLM agents, and BI dashboards modeling interchange, GMV, spreads and user growth.",
    },
    {
        title: "Curriculum machine learning tooling",
        org: "The New England Center for Children",
        desc: "I built a transformer recommender that surfaces semantically adjacent lessons at sub-second latency, so a query for \"tomato\" returns grocery shopping and meal preparation next to the direct matches. I also fine-tuned Llama 3.1 8B with LoRA for curriculum-resource generation, grounded in internal technical documentation; expert reviewers confirmed it held the curriculum's voice.",
    },
    {
        title: "Retail data pipelines",
        org: "Teamcore",
        desc: "I led five engineers on AWS ETL (Glue, Athena, Lambda, S3) that ingested product-availability data from the B2B platforms of Cencosud, Falabella, Oxxo, Soriana and Walmart, and fed the dashboards our clients used for their decisions.",
    },
];

const projects = [
    {
        href: "https://huggingface.co/pebeto/Llama-3.1-70B-LatamGPT-SFT-1.0-NVFP4",
        title: "LatamGPT-70B-NVFP4",
        desc: "NVFP4 (W4A4) quantization of LatamGPT's 70B model on a single 32 GB workstation.",
    },
    {
        href: "https://huggingface.co/pebeto/amigo-lora",
        title: "Amigo",
        desc: "A privacy-first voice companion that runs a small LLM on a laptop CPU, with no GPU: faster-whisper, Qwen3.5-4B on llama.cpp, Piper TTS, Chroma retrieval and a persona LoRA. I built it for the Hugging Face Build Small hackathon.",
    },
    {
        href: "https://github.com/JuliaAI/MLJ.jl",
        title: "MLJ.jl",
        desc: "A machine learning framework for Julia.",
    },
    {
        href: "https://github.com/JuliaAI/DearDiary.jl",
        title: "DearDiary.jl",
        desc: "Experiment tracking for machine learning in Julia.",
    },
    {
        href: "https://github.com/pebeto/MichiBoost.jl",
        title: "MichiBoost.jl",
        desc: "Pure-Julia gradient boosting with native categorical feature handling and symmetric decision trees.",
    },
    {
        href: "https://summerofcode.withgoogle.com/archive/2023/projects/iRxuzeGJ",
        title: "MLflow for Julia-based data science",
        desc: "Google Summer of Code 2023. I brought MLflow experiment tracking to the Julia ecosystem.",
    },
    {
        href: "https://github.com/JuliaAI/MLFlowClient.jl",
        title: "MLFlowClient.jl",
        desc: "A Julia client for the MLflow REST API.",
    },
    {
        href: "https://github.com/pebeto/ARP.jl",
        title: "ARP.jl",
        desc: "Auto-rotating perceptrons in Julia.",
    },
    {
        href: "https://github.com/pebeto/pluto-design-system",
        title: "pluto-design-system",
        desc: "A CSS framework in the Pluto.jl aesthetic.",
    },
    {
        href: "https://github.com/pebeto/missyhud.prx",
        title: "missyhud.prx",
        desc: "A PSP HUD plugin in C.",
    },
    {
        href: "https://github.com/pebeto/proton-ge-manager",
        title: "proton-ge-manager",
        desc: "Painless proton-ge installation for Steam Deck and Linux.",
    },
];

const honors = [
    {
        title: "Top 10% presentation spot, SMILES 2020",
        org: "Skolkovo Institute of Science and Technology",
        date: "August 2020",
        desc: "Skoltech picked me from more than 2,000 applicants to present a systematic review of convolutional neural networks for respiratory-condition detection.",
    },
    {
        title: "REPU Computer Science selection",
        org: "Research Experience for Peruvian Undergraduates",
        date: "October 2020",
        desc: "I joined as an undergraduate participant and worked under Gisella Bejarano in Arti Ramesh's research lab at Binghamton University.",
    },
    {
        title: "Cybersecurity scholarship",
        org: "Organization of American States",
        date: "May 2019",
        desc: "The OAS gave me a place in Creando una Trayectoria Profesional en Seguridad Digital, which included training at Universidad Federico Villarreal in Lima.",
    },
];

const service = [
    {
        title: "Judge, REPU Seminar 2026",
        org: "Research Experience for Peruvian Undergraduates",
        date: "April 2026",
        desc: "I evaluated undergraduate research presentations across scientific disciplines and wrote feedback for each participant.",
    },
    {
        title: "Reviewer, IEEE Intercon 2024",
        org: "IEEE",
        date: "July 2024",
        desc: "I reviewed paper submissions for technical accuracy, originality and fit with the conference program.",
    },
];
---

<Layout
    title="Portfolio"
    description="Publications, production machine learning systems, open-source Julia software and notebooks by Jose Esparza, Senior AI Engineer."
    canonical="/portfolio"
>
    <main class="max-w-6xl mx-auto px-6 sm:px-12 py-16">
        <div class="flex flex-col md:flex-row md:gap-12 lg:gap-20">
            <div class="md:w-1/3 md:shrink-0">
                <div class="md:sticky md:top-12">
                    <img
                        src="/missy.jpeg"
                        alt="Missy"
                        class="w-full max-w-xs md:max-w-none mx-auto md:mx-0 rounded-sm"
                    />
                    <p class="text-xs text-[var(--color-text-faint)] mt-4 italic">
                        Missy
                    </p>
                </div>
            </div>

            <div
                class="md:w-2/3 md:pl-10 md:border-l md:border-[var(--color-border-light)] space-y-10 mt-12 md:mt-0"
            >
                <p class="text-[var(--color-text)] leading-relaxed">
                    Most of my industry work is closed-source, so I describe those
                    systems only as far as the work allows. For names and dates,
                    see my{" "}
                    <a href="/resume.pdf" target="_blank">resume</a>.
                </p>

                <h2 class="text-2xl font-semibold text-[var(--color-heading)]">
                    Publications
                </h2>

                <ol class="space-y-5">
                    {
                        publications.map((pub) => (
                            <li>
                                <a
                                    href={pub.href}
                                    target="_blank"
                                    class="font-semibold text-[var(--color-heading)]"
                                >
                                    {pub.title}
                                </a>
                                <p class="text-sm text-[var(--color-text-muted)] mt-1">
                                    {pub.authors} ({pub.year}). {pub.venue}.
                                    {pub.doi && (
                                        <span class="text-[var(--color-text-faint)]">
                                            {" "}
                                            doi:{pub.doi}
                                        </span>
                                    )}
                                </p>
                            </li>
                        ))
                    }
                </ol>
                <p class="text-sm text-[var(--color-text-faint)]">
                    <a href="https://orcid.org/0000-0002-9372-3763" target="_blank"
                        >ORCID 0000-0002-9372-3763 ↗</a
                    >
                </p>

                <h2
                    class="text-2xl font-semibold text-[var(--color-heading)] pt-6"
                >
                    Production systems
                </h2>

                <div class="space-y-6">
                    {
                        systems.map((system) => (
                            <div>
                                <div class="flex items-baseline gap-2 flex-wrap">
                                    <span class="font-semibold text-[var(--color-heading)]">
                                        {system.title}
                                    </span>
                                    <span class="text-xs uppercase tracking-wider text-[var(--color-text-faint)]">
                                        {system.org}
                                    </span>
                                </div>
                                <p class="text-sm text-[var(--color-text-muted)] mt-1 leading-relaxed">
                                    {system.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <h2
                    class="text-2xl font-semibold text-[var(--color-heading)] pt-6"
                >
                    Open-source software
                </h2>

                <div class="space-y-5">
                    {
                        projects.map((project) => (
                            <div>
                                <a
                                    href={project.href}
                                    target="_blank"
                                    class="font-semibold text-[var(--color-heading)]"
                                >
                                    {project.title}
                                </a>
                                <p class="text-sm text-[var(--color-text-muted)] mt-1 leading-relaxed">
                                    {project.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <p class="text-[var(--color-text)]">
                    Further repositories are on my{" "}
                    <a href="https://github.com/pebeto" target="_blank"
                        >GitHub profile</a
                    >.
                </p>

                <h2
                    class="text-2xl font-semibold text-[var(--color-heading)] pt-6"
                >
                    Notebooks
                </h2>
                <p class="text-[var(--color-text)] leading-relaxed">
                    I reimplemented classic teaching notebooks in{" "}
                    <a href="https://julialang.org/" target="_blank">Julia</a>{" "}
                    with{" "}
                    <a href="https://plutojl.org/" target="_blank">Pluto.jl</a>,
                    which keeps them reactive and reproducible.
                </p>

                <div class="space-y-8">
                    {
                        Object.entries(groupedNotebooks).map(
                            ([category, categoryNotebooks]) => (
                                <div>
                                    <h3 class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-faint)] mb-3">
                                        {category}
                                    </h3>
                                    <div class="space-y-2">
                                        {categoryNotebooks.map((notebook) => (
                                            <div class="flex items-center gap-2">
                                                <span class="w-1 h-1 rounded-full bg-[var(--color-dot-muted)] shrink-0" />
                                                <a
                                                    href={notebook.link}
                                                    target="_blank"
                                                    class="text-sm text-[var(--color-text)] hover:text-[var(--color-heading)] transition-colors"
                                                >
                                                    {notebook.title}
                                                </a>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )
                        )
                    }
                </div>

                <h2
                    class="text-2xl font-semibold text-[var(--color-heading)] pt-6"
                >
                    Honors and awards
                </h2>

                <div class="space-y-6">
                    {
                        honors.map((honor) => (
                            <div>
                                <span class="font-semibold text-[var(--color-heading)]">
                                    {honor.title}
                                </span>
                                <p class="text-xs uppercase tracking-wider text-[var(--color-text-faint)] mt-1">
                                    {honor.org} · {honor.date}
                                </p>
                                <p class="text-sm text-[var(--color-text-muted)] mt-2 leading-relaxed">
                                    {honor.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <h2
                    class="text-2xl font-semibold text-[var(--color-heading)] pt-6"
                >
                    Academic service
                </h2>

                <div class="space-y-6">
                    {
                        service.map((item) => (
                            <div>
                                <span class="font-semibold text-[var(--color-heading)]">
                                    {item.title}
                                </span>
                                <p class="text-xs uppercase tracking-wider text-[var(--color-text-faint)] mt-1">
                                    {item.org} · {item.date}
                                </p>
                                <p class="text-sm text-[var(--color-text-muted)] mt-2 leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </main>
</Layout>
